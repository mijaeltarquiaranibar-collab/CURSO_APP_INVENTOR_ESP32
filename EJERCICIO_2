// ==========================================================

bool alarmaActiva = false;

int frecuenciaAlarma = 500;

int direccionAlarma = 1;

unsigned long tiempoAlarma = 0;

int ciclosAlarma = 0;

#define PASO_ALARMA 20
#define VELOCIDAD_ALARMA 10
#define MAX_CICLOS_ALARMA 6


// ==========================================================
// NOMBRE DE LA MELODÍA
// ==========================================================

String nombreMelodia = "";


// ==========================================================
// FUNCIÓN PARA APLICAR VOLUMEN
// ==========================================================

void aplicarVolumen()
{
  ledcWrite(BUZZER, volumen);
}


// ==========================================================
// TOCAR UNA FRECUENCIA
// ==========================================================

void tocarFrecuencia(int frecuencia)
{
  if (frecuencia > 0)
  {
    ledcWriteTone(BUZZER, frecuencia);

    // Aplicar volumen
    ledcWrite(BUZZER, volumen);
  }
  else
  {
    ledcWriteTone(BUZZER, 0);
    ledcWrite(BUZZER, 0);
  }
}


// ==========================================================
// DETENER BUZZER
// ==========================================================

void apagarBuzzer()
{
  ledcWriteTone(BUZZER, 0);
  ledcWrite(BUZZER, 0);
}


// ==========================================================
// ENVIAR ESTADO A APP INVENTOR
// ==========================================================

void enviarEstado(String estado)
{
  String mensaje;

  mensaje = "ESTADO:" + estado;

  if (nombreMelodia != "")
  {
    mensaje += " | MELODIA:" + nombreMelodia;
  }

  mensaje += " | VOLUMEN:" + String(volumen);

  Serial.println(mensaje);

  if (SerialBT.hasClient())
  {
    SerialBT.println(mensaje);
  }
}


// ==========================================================
// DETENER TODO
// ==========================================================

void detenerTodo()
{
  reproduciendo = false;
  alarmaActiva = false;

  melodiaActual = NULL;

  notaActual = 0;
  cantidadNotas = 0;

  apagarBuzzer();

  nombreMelodia = "";

  enviarEstado("DETENIDO");
}


// ==========================================================
// INICIAR MELODÍA
// ==========================================================

void iniciarMelodia(Nota* melodia, int cantidad, String nombre)
{
  // Detener reproducción anterior
  apagarBuzzer();

  alarmaActiva = false;

  melodiaActual = melodia;

  cantidadNotas = cantidad;

  notaActual = 0;

  reproduciendo = true;

  nombreMelodia = nombre;

  tiempoInicioNota = millis();

  tocarFrecuencia(melodiaActual[0].frecuencia);

  enviarEstado("TOCANDO");

  Serial.println("Iniciando: " + nombre);
}


// ==========================================================
// ACTUALIZAR MELODÍA
// ==========================================================

void actualizarMelodia()
{
  if (!reproduciendo)
  {
    return;
  }


  unsigned long ahora = millis();


  // Verificar duración de la nota actual
  if (ahora - tiempoInicioNota >=
      melodiaActual[notaActual].duracion)
  {

    // Apagar nota anterior
    apagarBuzzer();

    notaActual++;

    // ¿Terminó la melodía?
    if (notaActual >= cantidadNotas)
    {
      reproduciendo = false;

      nombreMelodia = "";

      apagarBuzzer();

      enviarEstado("LIBRE");

      Serial.println("Melodia terminada");

      return;
    }


    // Siguiente nota
    tiempoInicioNota = ahora;

    tocarFrecuencia(
      melodiaActual[notaActual].frecuencia
    );
  }
}


// ==========================================================
// INICIAR ALARMA
// ==========================================================

void iniciarAlarma()
{
  apagarBuzzer();

  reproduciendo = false;

  alarmaActiva = true;

  frecuenciaAlarma = 500;

  direccionAlarma = 1;

  ciclosAlarma = 0;

  tiempoAlarma = millis();

  nombreMelodia = "Alarma";

  tocarFrecuencia(frecuenciaAlarma);

  enviarEstado("ALARMA");

  Serial.println("Alarma iniciada");
}


// ==========================================================
// ACTUALIZAR ALARMA
// ==========================================================

void actualizarAlarma()
{
  if (!alarmaActiva)
  {
    return;
  }


  unsigned long ahora = millis();


  if (ahora - tiempoAlarma >= VELOCIDAD_ALARMA)
  {
    tiempoAlarma = ahora;


    // Subir o bajar frecuencia
    frecuenciaAlarma +=
      direccionAlarma * PASO_ALARMA;


    // Llegó al máximo
    if (frecuenciaAlarma >= 1500)
    {
      frecuenciaAlarma = 1500;

      direccionAlarma = -1;
    }


    // Llegó al mínimo
    if (frecuenciaAlarma <= 500)
    {
      frecuenciaAlarma = 500;

      direccionAlarma = 1;

      ciclosAlarma++;

      // Verificar cantidad de ciclos
      if (ciclosAlarma >= MAX_CICLOS_ALARMA)
      {
        alarmaActiva = false;

        apagarBuzzer();

        nombreMelodia = "";

        enviarEstado("LIBRE");

        Serial.println("Alarma terminada");

        return;
      }
    }


    tocarFrecuencia(frecuenciaAlarma);
  }
}


// ==========================================================
// AUMENTAR VOLUMEN
// ==========================================================

void aumentarVolumen()
{
  volumen = volumen + 16;

  if (volumen >= 255)
  {
    volumen = 255;
  }

  Serial.print("VOL + -> ");
  Serial.println(volumen);

  aplicarVolumen();

  enviarEstado("VOLUMEN");
}


// ==========================================================
// DISMINUIR VOLUMEN
// ==========================================================

void disminuirVolumen()
{
  volumen = volumen - 16;

  if (volumen <= 0)
  {
    volumen = 0;
  }

  Serial.print("VOL - -> ");
  Serial.println(volumen);

  aplicarVolumen();

  enviarEstado("VOLUMEN");
}


// ==========================================================
// PROCESAR COMANDO BLUETOOTH
// ==========================================================

void procesarComando(String comando)
{
  comando.trim();

  Serial.println("Bluetooth -> " + comando);


  // --------------------------------------------------------
  // VIDEOJUEGO
  // --------------------------------------------------------

  if (comando == "1")
  {
    iniciarMelodia(
      melodiaVideojuego,
      NUM_NOTAS_VIDEOJUEGO,
      "Videojuego"
    );
  }


  // --------------------------------------------------------
  // STAR WARS
  // --------------------------------------------------------

  else if (comando == "2")
  {
    iniciarMelodia(
      melodiaStarWars,
      NUM_NOTAS_STARWARS,
      "Star Wars"
    );
  }


  // --------------------------------------------------------
  // ALARMA
  // --------------------------------------------------------

  else if (comando == "3")
  {
    iniciarAlarma();
  }


  // --------------------------------------------------------
  // DETENER
  // --------------------------------------------------------

  else if (comando == "4")
  {
    detenerTodo();
  }


  // --------------------------------------------------------
  // VOLUMEN +
  // --------------------------------------------------------

  else if (comando == "V")
  {
    aumentarVolumen();
  }


  // --------------------------------------------------------
  // VOLUMEN -
  // --------------------------------------------------------

  else if (comando == "v")
  {
    disminuirVolumen();
  }
}


// ==========================================================
// LEER BLUETOOTH
// ==========================================================

void revisarBluetooth()
{
  while (SerialBT.available())
  {
    char comando = SerialBT.read();

    Serial.print("Comando Bluetooth recibido: ");
    Serial.println(comando);

    // --------------------------------------
    // VIDEOJUEGO
    // --------------------------------------

    if (comando == '1')
    {
      iniciarMelodia(
        melodiaVideojuego,
        NUM_NOTAS_VIDEOJUEGO,
        "Videojuego"
      );
    }


    // --------------------------------------
    // STAR WARS
    // --------------------------------------

    else if (comando == '2')
    {
      iniciarMelodia(
        melodiaStarWars,
        NUM_NOTAS_STARWARS,
        "Star Wars"
      );
    }


    // --------------------------------------
    // ALARMA
    // --------------------------------------

    else if (comando == '3')
    {
      iniciarAlarma();
    }


    // --------------------------------------
    // DETENER
    // --------------------------------------

    else if (comando == '4')
    {
      detenerTodo();
    }


    // --------------------------------------
    // VOLUMEN +
    // --------------------------------------

    else if (comando == 'V')
    {
      aumentarVolumen();
    }


    // --------------------------------------
    // VOLUMEN -
    // --------------------------------------

    else if (comando == 'v')
    {
      disminuirVolumen();
    }
  }
}

// ==========================================================
// BOTONES FÍSICOS
// ==========================================================

bool estadoAnteriorBoton1 = LOW;
bool estadoAnteriorBoton2 = LOW;
bool estadoAnteriorBoton3 = LOW;


// ==========================================================
// REVISAR BOTONES FÍSICOS
// ==========================================================

void revisarBotones()
{
  bool boton1 = digitalRead(BOTON_VIDEOJUEGO);
  bool boton2 = digitalRead(BOTON_STARWARS);
  bool boton3 = digitalRead(BOTON_ALARMA);


  // --------------------------------------------------------
  // BOTÓN 1
  // --------------------------------------------------------

  if (boton1 == HIGH && estadoAnteriorBoton1 == LOW)
  {
    iniciarMelodia(
      melodiaVideojuego,
      NUM_NOTAS_VIDEOJUEGO,
      "Videojuego"
    );
  }


  // --------------------------------------------------------
  // BOTÓN 2
  // --------------------------------------------------------

  if (boton2 == HIGH && estadoAnteriorBoton2 == LOW)
  {
    iniciarMelodia(
      melodiaStarWars,
      NUM_NOTAS_STARWARS,
      "Star Wars"
    );
  }


  // --------------------------------------------------------
  // BOTÓN 3
  // --------------------------------------------------------

  if (boton3 == HIGH && estadoAnteriorBoton3 == LOW)
  {
    iniciarAlarma();
  }


  // Guardar estados
  estadoAnteriorBoton1 = boton1;
  estadoAnteriorBoton2 = boton2;
  estadoAnteriorBoton3 = boton3;
}


// ==========================================================
// SETUP
// ==========================================================

void setup()
{
  Serial.begin(115200);


  // --------------------------------------------------------
  // PULSADORES
  // --------------------------------------------------------

  pinMode(BOTON_VIDEOJUEGO, INPUT);
  pinMode(BOTON_STARWARS, INPUT);
  pinMode(BOTON_ALARMA, INPUT);


  // --------------------------------------------------------
  // BUZZER
  // --------------------------------------------------------

  ledcAttach(BUZZER, 1000, 8);

  apagarBuzzer();


  // --------------------------------------------------------
  // BLUETOOTH
  // --------------------------------------------------------

  SerialBT.begin("ESP32_SONIDO");


  // --------------------------------------------------------
  // MENSAJES
  // --------------------------------------------------------

  Serial.println();
  Serial.println("========================================");
  Serial.println("       ESP32 - SISTEMA DE SONIDO");
  Serial.println("========================================");
  Serial.println("Bluetooth: ESP32_SONIDO");
  Serial.println();
  Serial.println("GPIO 16 -> Videojuego");
  Serial.println("GPIO 17 -> Star Wars");
  Serial.println("GPIO 18 -> Alarma");
  Serial.println("GPIO 15 -> Buzzer");
  Serial.println();
  Serial.println("Comandos Bluetooth:");
  Serial.println("1 -> Videojuego");
  Serial.println("2 -> Star Wars");
  Serial.println("3 -> Alarma");
  Serial.println("4 -> Detener");
  Serial.println("V -> Volumen +");
  Serial.println("v -> Volumen -");
  Serial.println("========================================");

  enviarEstado("LISTO");
}


// ==========================================================
// LOOP
// ==========================================================

void loop()
{
  // ========================================================
  // REVISAR BLUETOOTH
  // ========================================================

  revisarBluetooth();


  // ========================================================
  // REVISAR BOTONES FÍSICOS
  // ========================================================

  revisarBotones();


  // ========================================================
  // ACTUALIZAR MELODÍA
  // ========================================================

  actualizarMelodia();


  // ========================================================
  // ACTUALIZAR ALARMA
  // ========================================================

  actualizarAlarma();
}
