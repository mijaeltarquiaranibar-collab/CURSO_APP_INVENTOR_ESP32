#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>

// =====================================================
// WIFI
// =====================================================

const char* WIFI_SSID = "  ";
const char* WIFI_PASSWORD = "  ";

// =====================================================
// EMQX
// =====================================================

const char* MQTT_HOST = "   ";
const int MQTT_PORT =  ;

const char* MQTT_USER = "  ";
const char* MQTT_PASSWORD = "  ";

// =====================================================
// PINES
// =====================================================

#define MQ135_PIN       35
#define BUTTON_PIN      16
#define BUZZER_PIN      15
#define FLAME_PIN        4
#define RELAY_PIN       19

// =====================================================
// TOPICS MQTT
// =====================================================

const char* TOPIC_MQ135 = "esp32/aire/mq135";
const char* TOPIC_CONTAMINACION = "esp32/aire/contaminacion";
const char* TOPIC_FLAMA = "esp32/aire/flama";
const char* TOPIC_BUZZER = "esp32/aire/buzzer";
const char* TOPIC_RELAY = "esp32/aire/relay";
const char* TOPIC_RELAY_SET = "esp32/aire/relay/set";

// =====================================================
// OBJETOS
// =====================================================

WiFiClientSecure espClient;
PubSubClient mqttClient(espClient);

// =====================================================
// RELAY
// =====================================================

#define RELAY_ON  HIGH
#define RELAY_OFF LOW

bool relayState = false;

// =====================================================
// BOTON
// =====================================================

bool lastButtonState = LOW;

// =====================================================
// MQ-135
// =====================================================

// Este valor es experimental.
// NO representa ppm.

const int UMBRAL_CONTAMINACION = 1800;

int valorMQ135 = 0;
bool contaminacionState = false;

// =====================================================
// FLAMA
// =====================================================

bool flamaState = false;

// =====================================================
// BUZZER
// =====================================================

bool buzzerState = false;

const int FRECUENCIA_BUZZER = 2000;

// =====================================================
// CONECTAR WIFI
// =====================================================

void conectarWiFi() {

  Serial.println();
  Serial.print("Conectando a WiFi: ");
  Serial.println(WIFI_SSID);

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  while (WiFi.status() != WL_CONNECTED) {

    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WiFi conectado");

  Serial.print("IP del ESP32: ");
  Serial.println(WiFi.localIP());
}

// =====================================================
// PUBLICAR RELAY
// =====================================================

void publicarRelay() {

  bool resultado;

  if (relayState) {

    resultado = mqttClient.publish(
      TOPIC_RELAY,
      "ON",
      true
    );

    Serial.print("MQTT Relay -> ON : ");
    
  } else {

    resultado = mqttClient.publish(
      TOPIC_RELAY,
      "OFF",
      true
    );

    Serial.print("MQTT Relay -> OFF : ");
  }

  Serial.println(resultado ? "OK" : "ERROR");
}

// =====================================================
// CAMBIAR RELAY
// =====================================================

void cambiarRelay(bool estado) {

  relayState = estado;

  if (relayState) {

    digitalWrite(
      RELAY_PIN,
      RELAY_ON
    );

  } else {

    digitalWrite(
      RELAY_PIN,
      RELAY_OFF
    );
  }

  publicarRelay();
}

// =====================================================
// PUBLICAR BUZZER
// =====================================================

void publicarBuzzer() {

  bool resultado;

  if (buzzerState) {

    resultado = mqttClient.publish(
      TOPIC_BUZZER,
      "ON",
      true
    );

    Serial.print("MQTT Buzzer -> ON : ");

  } else {

    resultado = mqttClient.publish(
      TOPIC_BUZZER,
      "OFF",
      true
    );

    Serial.print("MQTT Buzzer -> OFF : ");
  }

  Serial.println(resultado ? "OK" : "ERROR");
}

// =====================================================
// CONTROL BUZZER
// =====================================================

void controlarBuzzer(bool activar) {

  if (activar) {

    if (!buzzerState) {

      buzzerState = true;

      tone(
        BUZZER_PIN,
        FRECUENCIA_BUZZER
      );

      Serial.println("BUZZER: ON");
    }

  } else {

    if (buzzerState) {

      buzzerState = false;

      noTone(BUZZER_PIN);

      Serial.println("BUZZER: OFF");
    }
  }
}

// =====================================================
// PUBLICAR MQ-135
// =====================================================

void publicarMQ135() {

  char valorTexto[12];

  itoa(
    valorMQ135,
    valorTexto,
    10
  );

  bool resultado = mqttClient.publish(
    TOPIC_MQ135,
    valorTexto,
    true
  );

  Serial.print("MQTT MQ135 -> ");
  Serial.print(valorTexto);
  Serial.print(" : ");
  Serial.println(
    resultado ? "OK" : "ERROR"
  );
}

// =====================================================
// PUBLICAR CONTAMINACION
// =====================================================

void publicarContaminacion() {

  bool resultado;

  if (contaminacionState) {

    resultado = mqttClient.publish(
      TOPIC_CONTAMINACION,
      "DETECTADA",
      true
    );

    Serial.print(
      "MQTT Contaminacion -> DETECTADA : "
    );

  } else {

    resultado = mqttClient.publish(
      TOPIC_CONTAMINACION,
      "NORMAL",
      true
    );

    Serial.print(
      "MQTT Contaminacion -> NORMAL : "
    );
  }

  Serial.println(
    resultado ? "OK" : "ERROR"
  );
}

// =====================================================
// PUBLICAR FLAMA
// =====================================================

void publicarFlama() {

  bool resultado;

  if (flamaState) {

    resultado = mqttClient.publish(
      TOPIC_FLAMA,
      "DETECTADO",
      true
    );

    Serial.print(
      "MQTT Flama -> DETECTADO : "
    );

  } else {

    resultado = mqttClient.publish(
      TOPIC_FLAMA,
      "NO_DETECTADO",
      true
    );

