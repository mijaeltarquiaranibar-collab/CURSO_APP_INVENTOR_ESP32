// ==========================================================
// ALARMA
// ==========================================================

void alarma()
{
  reproduciendo = true;
  ultimaMelodia = "Alarma";
  enviarEstado();

  Serial.println("=================================");
  Serial.println("             ALARMA");
  Serial.println("=================================");

  for (int ciclo = 0; ciclo < 6; ciclo++)
  {
    // Subida
    for (int frecuencia = 500; frecuencia <= 1500; frecuencia += 20)
    {
      ledcWriteTone(BUZZER, frecuencia);
      delay(10);
    }

    // Bajada
    for (int frecuencia = 1500; frecuencia >= 500; frecuencia -= 20)
    {
      ledcWriteTone(BUZZER, frecuencia);
      delay(10);
    }
  }

  ledcWriteTone(BUZZER, 0);
  delay(200);

  reproduciendo = false;
  enviarEstado();
}


// ==========================================================
// SETUP
// ==========================================================

void setup()
{
  Serial.begin(115200);

  // --------------------------------------------------------
  // BLUETOOTH
  // --------------------------------------------------------
  // Nombre que aparecerá al buscar desde el celular
  SerialBT.begin("ESP32-Buzzer");
  Serial.println("Bluetooth iniciado: ESP32-Buzzer");

  // --------------------------------------------------------
  // PULSADORES
  // --------------------------------------------------------
  pinMode(BOTON_VIDEOJUEGO, INPUT);
  pinMode(BOTON_STARWARS, INPUT);
  pinMode(BOTON_ALARMA, INPUT);

  // --------------------------------------------------------
  // BUZZER PASIVO
  // --------------------------------------------------------
  ledcAttach(BUZZER, 1000, 8);
  ledcWriteTone(BUZZER, 0);

  // --------------------------------------------------------
  // MENSAJE INICIAL
  // --------------------------------------------------------
  Serial.println();
  Serial.println("========================================");
  Serial.println("   ESP32 - SISTEMA DE SONIDO + BT");
  Serial.println("========================================");
  Serial.println("GPIO 16 -> Videojuego");
  Serial.println("GPIO 17 -> Star Wars");
  Serial.println("GPIO 18 -> Alarma");
  Serial.println("GPIO 15 -> Buzzer");
  Serial.println("----------------------------------------");
  Serial.println("COMANDOS BLUETOOTH:");
  Serial.println("  '1' -> Videojuego");
  Serial.println("  '2' -> Star Wars");
  Serial.println("  '3' -> Alarma");
  Serial.println("  '4' -> Detener");
  Serial.println("  'V' -> Subir volumen");
  Serial.println("  'v' -> Bajar volumen");
  Serial.println("  '?' -> Consultar estado");
  Serial.println("========================================");
  Serial.println("Sistema listo.");
}


// ==========================================================
// LOOP
// ==========================================================

void loop()
{

  // ========================================================
  // RECIBIR COMANDOS BLUETOOTH
  // ========================================================

  if (SerialBT.available())
  {
    char cmd = SerialBT.read();
    Serial.print("Comando BT recibido: ");
    Serial.println(cmd);

    switch (cmd)
    {
      case '1':
        melodiaVideojuego();
        break;

      case '2':
        melodiaStarWars();
        break;

      case '3':
        alarma();
        break;

      case '4':
        detenerSonido();
        break;

      case 'V':
        volumen = min(volumen + VOLUMEN_PASO, VOLUMEN_MAX);
        Serial.print("Volumen: ");
        Serial.println(volumen);
        enviarEstado();
        break;

      case 'v':
        volumen = max(volumen - VOLUMEN_PASO, VOLUMEN_MIN);
        Serial.print("Volumen: ");
        Serial.println(volumen);
        enviarEstado();
        break;

      case '?':
        enviarEstado();
        break;
    }
  }


  // ========================================================
  // BOTÓN 1 - VIDEOJUEGO (físico)
  // ========================================================

  if (digitalRead(BOTON_VIDEOJUEGO) == HIGH)
  {
    delay(30);
    if (digitalRead(BOTON_VIDEOJUEGO) == HIGH)
    {
      melodiaVideojuego();

      while (digitalRead(BOTON_VIDEOJUEGO) == HIGH)
      {
        delay(10);
      }

      delay(80);
    }
  }


  // ========================================================
  // BOTÓN 2 - STAR WARS (físico)
  // ========================================================

  if (digitalRead(BOTON_STARWARS) == HIGH)
  {
    delay(30);
    if (digitalRead(BOTON_STARWARS) == HIGH)
    {
      melodiaStarWars();

      while (digitalRead(BOTON_STARWARS) == HIGH)
      {
        delay(10);
      }

      delay(80);
    }
  }


  // ========================================================
  // BOTÓN 3 - ALARMA (físico)
  // ========================================================

  if (digitalRead(BOTON_ALARMA) == HIGH)
  {
    delay(30);
    if (digitalRead(BOTON_ALARMA) == HIGH)
    {
      alarma();

      while (digitalRead(BOTON_ALARMA) == HIGH)
      {
        delay(10);
      }

      delay(80);
    }
  }
}
