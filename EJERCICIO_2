  beep(F5, 125);
  beep(FS5, 250);

  delay(325);

  // Tercera frase
  beep(AS4, 250);
  beep(DS5, 500);
  beep(D5, 325);

  beep(CS5, 175);
  beep(C5, 125);

  beep(B4, 125);
  beep(C5, 250);

  delay(350);

