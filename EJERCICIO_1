#include "BluetoothSerial.h"

BluetoothSerial SerialBT;

// ==========================
// LEDS
// ==========================
#define LED1 12
#define LED2 13
#define LED3 14

// ==========================
// PULSADORES FISICOS
// ==========================
#define BOTON1 16
#define BOTON2 17
#define BOTON3 18

// ==========================
// ESTADOS DE LOS LEDS
// ==========================

// Estado general de cada LED
bool estadoLED1 = false;
bool estadoLED2 = false;
bool estadoLED3 = false;

// Estados anteriores de los pulsadores
bool estadoBoton1Anterior = LOW;
bool estadoBoton2Anterior = LOW;
bool estadoBoton3Anterior = LOW;

// ==========================
// REBOTE DE PULSADORES
// ==========================

unsigned long ultimoTiempoBoton1 = 0;
unsigned long ultimoTiempoBoton2 = 0;
unsigned long ultimoTiempoBoton3 = 0;

const unsigned long TIEMPO_REBOTE = 50;


void setup() {

  Serial.begin(115200);

  // ==========================
  // BLUETOOTH
  // ==========================

  SerialBT.begin("ESP32_CONTROL_LEDS");

  Serial.println("ESP32 listo");
  Serial.println("Bluetooth: ESP32_CONTROL_LEDS");


  // ==========================
  // LEDS
  // ==========================

  pinMode(LED1, OUTPUT);
  pinMode(LED2, OUTPUT);
  pinMode(LED3, OUTPUT);


  // ==========================
  // PULSADORES
  // PULL-DOWN EXTERNO
  // ==========================

  pinMode(BOTON1, INPUT);
  pinMode(BOTON2, INPUT);
  pinMode(BOTON3, INPUT);


  // ==========================
  // ESTADO INICIAL
  // ==========================

  digitalWrite(LED1, LOW);
  digitalWrite(LED2, LOW);
  digitalWrite(LED3, LOW);
}


void loop() {

  // =================================================
  // 1. RECIBIR COMANDOS DESDE APP INVENTOR
  // =================================================

  if (SerialBT.available()) {

    String comando = SerialBT.readStringUntil('\n');
    comando.trim();

    Serial.print("Comando recibido: ");
    Serial.println(comando);


    // -------------------------
    // LED 1 DESDE APP
    // -------------------------

    if (comando == "LED1") {

      estadoLED1 = !estadoLED1;

      digitalWrite(LED1, estadoLED1);
    }


    // -------------------------
    // LED 2 DESDE APP
    // -------------------------

    if (comando == "LED2") {

      estadoLED2 = !estadoLED2;

      digitalWrite(LED2, estadoLED2);
    }


    // -------------------------
    // LED 3 DESDE APP
    // -------------------------

    if (comando == "LED3") {

      estadoLED3 = !estadoLED3;

      digitalWrite(LED3, estadoLED3);
    }
  }


  // =================================================
  // 2. LEER PULSADORES FISICOS
  // =================================================

  bool boton1 = digitalRead(BOTON1);
  bool boton2 = digitalRead(BOTON2);
  bool boton3 = digitalRead(BOTON3);


  // =================================================
  // 3. PULSADOR 1 → TOGGLE LED 1
  // =================================================

  if (boton1 == HIGH && estadoBoton1Anterior == LOW) {

    if (millis() - ultimoTiempoBoton1 > TIEMPO_REBOTE) {

      estadoLED1 = !estadoLED1;

      digitalWrite(LED1, estadoLED1);

      Serial.print("BOTON1 -> LED1: ");
      Serial.println(estadoLED1 ? "ON" : "OFF");

      ultimoTiempoBoton1 = millis();
    }
  }

  estadoBoton1Anterior = boton1;


  // =================================================
  // 4. PULSADOR 2 → TOGGLE LED 2
  // =================================================

  if (boton2 == HIGH && estadoBoton2Anterior == LOW) {

    if (millis() - ultimoTiempoBoton2 > TIEMPO_REBOTE) {

      estadoLED2 = !estadoLED2;

      digitalWrite(LED2, estadoLED2);

      Serial.print("BOTON2 -> LED2: ");
      Serial.println(estadoLED2 ? "ON" : "OFF");

      ultimoTiempoBoton2 = millis();
    }
  }

  estadoBoton2Anterior = boton2;


  // =================================================
  // 5. PULSADOR 3 → TOGGLE LED 3
  // =================================================

  if (boton3 == HIGH && estadoBoton3Anterior == LOW) {

    if (millis() - ultimoTiempoBoton3 > TIEMPO_REBOTE) {

      estadoLED3 = !estadoLED3;

      digitalWrite(LED3, estadoLED3);

      Serial.print("BOTON3 -> LED3: ");
      Serial.println(estadoLED3 ? "ON" : "OFF");

      ultimoTiempoBoton3 = millis();
    }
  }

  estadoBoton3Anterior = boton3;


  delay(5);
}
