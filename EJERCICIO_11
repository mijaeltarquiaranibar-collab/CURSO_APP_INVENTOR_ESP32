// =====================================================
// CALLBACK MQTT
// =====================================================

void mqttCallback(
  char* topic,
  byte* payload,
  unsigned int length
) {

  String mensaje = "";

  for (
    unsigned int i = 0;
    i < length;
    i++
  ) {

    mensaje += (char)payload[i];
  }

  Serial.println();
  Serial.println(
    "========== MQTT RECIBIDO =========="
  );

  Serial.print("Topic: ");
  Serial.println(topic);

  Serial.print("Mensaje: ");
  Serial.println(mensaje);

  // ---------------------------------------------------
  // CONTROL DEL RELAY DESDE MQTT
  // ---------------------------------------------------

  if (
    String(topic) == TOPIC_RELAY_SET
  ) {

    if (mensaje == "ON") {

      cambiarRelay(true);

    } else if (mensaje == "OFF") {

      cambiarRelay(false);
    }
  }
}

// =====================================================
// CONECTAR MQTT
// =====================================================

void conectarMQTT() {

  while (!mqttClient.connected()) {

    Serial.println();
    Serial.print("Conectando a EMQX...");

    String clientID =
      "ESP32-Aire-Fuego-";

    clientID += String(
      (uint32_t)ESP.getEfuseMac(),
      HEX
    );

    if (
      mqttClient.connect(
        clientID.c_str(),
        MQTT_USER,
        MQTT_PASSWORD
      )
    ) {

      Serial.println(" OK");

      // Suscripción al control del relay
      mqttClient.subscribe(
        TOPIC_RELAY_SET
      );

      // Publicar estados iniciales
      publicarRelay();
      publicarBuzzer();

    } else {

      Serial.print(
        " ERROR, codigo="
      );

      Serial.println(
        mqttClient.state()
      );

      delay(5000);
    }
  }
}

// =====================================================
// LEER MQ-135
// =====================================================

void leerMQ135() {

  long suma = 0;

  // Tomar 10 lecturas
  for (int i = 0; i < 10; i++) {

    suma += analogRead(MQ135_PIN);

    delay(10);
  }

  valorMQ135 = suma / 10;

  Serial.print("MQ-135: ");
  Serial.println(valorMQ135);

  // ---------------------------------------------------
  // DETERMINAR CONTAMINACION
  // ---------------------------------------------------

  if (
    valorMQ135 >=
    UMBRAL_CONTAMINACION
  ) {

    contaminacionState = true;

    Serial.println(
      "CONTAMINACION: DETECTADA"
    );

    controlarBuzzer(true);

  } else {

    contaminacionState = false;

    Serial.println(
      "CONTAMINACION: NORMAL"
    );

    controlarBuzzer(false);
  }

  // Publicar inmediatamente
  publicarMQ135();
  publicarContaminacion();
  publicarBuzzer();
}

// =====================================================
// LEER SENSOR DE FLAMA
// =====================================================

void leerFlama() {

  int estadoFlama =
    digitalRead(FLAME_PIN);

  if (estadoFlama == LOW) {

    flamaState = true;

    Serial.println(
      "FLAMA: DETECTADA"
    );

  } else {

    flamaState = false;

    Serial.println(
      "FLAMA: NO DETECTADA"
    );
  }

  publicarFlama();
}

// =====================================================
// SETUP
// =====================================================

void setup() {

  Serial.begin(115200);

  // ---------------------------------------------------
  // PINES
  // ---------------------------------------------------

  pinMode(
    MQ135_PIN,
    INPUT
  );

  pinMode(
    BUTTON_PIN,
    INPUT
  );

  pinMode(
    FLAME_PIN,
    INPUT
  );

  pinMode(
    BUZZER_PIN,
    OUTPUT
  );

  pinMode(
    RELAY_PIN,
    OUTPUT
  );

  // ---------------------------------------------------
  // ESTADOS INICIALES
  // ---------------------------------------------------

  digitalWrite(
    RELAY_PIN,
    RELAY_OFF
  );

  noTone(BUZZER_PIN);

  relayState = false;
  buzzerState = false;
  lastButtonState = LOW;

  // ---------------------------------------------------
  // ADC ESP32
  // ---------------------------------------------------

  analogReadResolution(12);

  // Permitir medir un rango mayor de entrada ADC
  analogSetPinAttenuation(
    MQ135_PIN,
    ADC_11db
  );

  // ---------------------------------------------------
  // WIFI
  // ---------------------------------------------------

  conectarWiFi();

  // ---------------------------------------------------
  // TLS
  // ---------------------------------------------------

  espClient.setInsecure();

  // ---------------------------------------------------
  // MQTT
  // ---------------------------------------------------

  mqttClient.setServer(
    MQTT_HOST,
    MQTT_PORT
  );

  mqttClient.setCallback(
    mqttCallback
  );

  mqttClient.setBufferSize(512);

  conectarMQTT();

  // ---------------------------------------------------
  // MENSAJE DE INICIO
  // ---------------------------------------------------

  Serial.println();
  Serial.println(
    "=============================="
  );
  Serial.println(
    "      ESP32 AIRE Y FUEGO"
  );
  Serial.println(
    "=============================="
  );
  Serial.println();
}

// =====================================================
// LOOP
// =====================================================

void loop() {

  // ---------------------------------------------------
  // MQTT
  // ---------------------------------------------------

  if (!mqttClient.connected()) {

    conectarMQTT();
  }

  mqttClient.loop();

  // ---------------------------------------------------
  // PULSADOR
  // ---------------------------------------------------

  bool buttonState =
    digitalRead(BUTTON_PIN);

  if (
    buttonState == HIGH &&
    lastButtonState == LOW
  ) {

    delay(30);

    if (
      digitalRead(BUTTON_PIN) == HIGH
    ) {

      cambiarRelay(!relayState);

      Serial.println(
        "BOTON FISICO PULSADO"
      );

      while (
        digitalRead(BUTTON_PIN) == HIGH
      ) {

        delay(10);
      }
    }
  }

  lastButtonState =
    buttonState;

  // ---------------------------------------------------
  // MQ-135
  // ---------------------------------------------------

  static unsigned long
    tiempoMQ135 = 0;

  if (
    millis() - tiempoMQ135 >=
    2000
  ) {

    tiempoMQ135 = millis();

    leerMQ135();
  }

  // ---------------------------------------------------
  // FLAMA
  // ---------------------------------------------------

  static unsigned long
    tiempoFlama = 0;

  if (
    millis() - tiempoFlama >=
    1000
  ) {

    tiempoFlama = millis();

    leerFlama();
  }
}
