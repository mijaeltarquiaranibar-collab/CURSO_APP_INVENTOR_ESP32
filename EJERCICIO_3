// ==========================================================
// ESP32 — ADC + OLED + 3 LEDs + BLUETOOTH
// ==========================================================
//
// POTENCIOMETRO  -> GPIO 34
//
// OLED 128x64
// SDA -> GPIO 21
// SCL -> GPIO 22
//
// LED 1 VERDE -> GPIO 12
// LED 2 AMBAR  -> GPIO 13
// LED 3 ROJO   -> GPIO 14
//
// BLUETOOTH -> ESP32-ADC
//
// COMANDOS DESDE APP INVENTOR:
//
// V:xxx  -> Valor virtual desde Slider (0-4095)
// R      -> Regresar al potenciometro físico
// ?      -> Solicitar estado
//
// ==========================================================

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include "BluetoothSerial.h"

BluetoothSerial SerialBT;


// ==========================================================
// OLED
// ==========================================================

#define SCREEN_WIDTH  128
#define SCREEN_HEIGHT 64

Adafruit_SSD1306 display(
  SCREEN_WIDTH,
  SCREEN_HEIGHT,
  &Wire,
  -1
);


// ==========================================================
// PINES
// ==========================================================

#define PIN_POT   34

#define PIN_LED1  12
#define PIN_LED2  13
#define PIN_LED3  14


// ==========================================================
// VARIABLES
// ==========================================================

// Lectura física
int valorADC = 0;

// Valor enviado desde App Inventor
// -1 significa que se utiliza el potenciómetro físico
int valorForzado = -1;


// ==========================================================
// VARIABLES PARA BLUETOOTH
// ==========================================================

String bufferBT = "";


// ==========================================================
// VARIABLES PARA ENVÍO
// ==========================================================

unsigned long ultimoEnvio = 0;

#define INTERVALO_ENVIO 500


// ==========================================================
// CONTROL DE LEDS
// ==========================================================

void actualizarLEDs(int valor)
{
  if (valor < 1366)
  {
    // Rango bajo
    digitalWrite(PIN_LED1, HIGH);
    digitalWrite(PIN_LED2, LOW);
    digitalWrite(PIN_LED3, LOW);
  }

  else if (valor < 2731)
  {
    // Rango medio
    digitalWrite(PIN_LED1, HIGH);
    digitalWrite(PIN_LED2, HIGH);
    digitalWrite(PIN_LED3, LOW);
  }

  else
  {
    // Rango alto
    digitalWrite(PIN_LED1, HIGH);
    digitalWrite(PIN_LED2, HIGH);
    digitalWrite(PIN_LED3, HIGH);
  }
}


// ==========================================================
// ACTUALIZAR OLED
// ==========================================================

void actualizarOLED(int valor)
{
  int porcentaje = map(
    valor,
    0,
    4095,
    0,
    100
  );

  int barraAncho = map(
    valor,
    0,
    4095,
    0,
    108
  );


  display.clearDisplay();

  display.setTextColor(SSD1306_WHITE);


  // --------------------------------------------------------
  // TITULO
  // --------------------------------------------------------

  display.setTextSize(1);

  display.setCursor(0, 0);

  display.println("ADC POTENCIOMETRO");


  // --------------------------------------------------------
  // VALOR ADC
  // --------------------------------------------------------

  display.setTextSize(2);

  display.setCursor(0, 15);

  display.print(valor);


  // --------------------------------------------------------
  // PORCENTAJE
  // --------------------------------------------------------

  display.setTextSize(1);

  display.setCursor(70, 21);

  display.print(porcentaje);

  display.print(" %");


  // --------------------------------------------------------
  // BARRA
  // --------------------------------------------------------

  display.drawRect(
    0,
    38,
    112,
    10,
    SSD1306_WHITE
  );


  if (barraAncho > 0)
  {
    display.fillRect(
      2,
      40,
      barraAncho,
      6,
      SSD1306_WHITE
    );
  }


  // --------------------------------------------------------
  // LEDS
  // --------------------------------------------------------

  display.setCursor(0, 53);

  if (valor < 1366)
  {
    display.print("LEDs: [X][ ][ ]");
  }

  else if (valor < 2731)
  {
    display.print("LEDs: [X][X][ ]");
  }

  else
  {
    display.print("LEDs: [X][X][X]");
  }


  display.display();
}


// ==========================================================
// DETERMINAR CANTIDAD DE LEDS
// ==========================================================

int cantidadLEDs(int valor)
{
  if (valor < 1366)
  {
    return 1;
  }

  else if (valor < 2731)
  {
    return 2;
  }

  else
  {
    return 3;
  }
}


// ==========================================================
// ENVIAR ESTADO POR BLUETOOTH
// ==========================================================

void enviarEstado(int valor)
{
  int porcentaje = map(
    valor,
    0,
    4095,
    0,
    100
  );

  int leds = cantidadLEDs(valor);


  // --------------------------------------------------------
  // CREAR JSON
  // --------------------------------------------------------

  String mensaje = "{";

  mensaje += "\"adc\":";
  mensaje += String(valor);

  mensaje += ",\"pct\":";
  mensaje += String(porcentaje);

  mensaje += ",\"leds\":";
  mensaje += String(leds);

  mensaje += "}";


  // --------------------------------------------------------
  // ENVIAR
  // --------------------------------------------------------

  if (SerialBT.hasClient())
  {
    SerialBT.println(mensaje);
  }


  Serial.print("BT -> ");

  Serial.println(mensaje);
}


// ==========================================================
// PROCESAR COMANDO
// ==========================================================

void procesarComando(String comando)
{
  comando.trim();


  Serial.print("Comando recibido: ");

  Serial.println(comando);


  // ========================================================
  // COMANDO V:XXX
  // ========================================================

  if (comando.startsWith("V:"))
  {
    String numero = comando.substring(2);

    int valor = numero.toInt();

    valor = constrain(
      valor,
      0,
      4095
    );

    valorForzado = valor;


    Serial.print("Valor virtual: ");

    Serial.println(valor);
  }


  // ========================================================
  // COMANDO R
  // ========================================================

  else if (comando == "R")
  {
    valorForzado = -1;

    Serial.println(
      "Control regresado al potenciometro fisico"
    );
  }


  // ========================================================
  // COMANDO ?
  // ========================================================

  else if (comando == "?")
  {
    int valorActual;

    if (valorForzado >= 0)
    {
      valorActual = valorForzado;
    }
    else
    {
      valorActual = valorADC;
    }

    enviarEstado(valorActual);
  }
}


// ==========================================================
// RECIBIR BLUETOOTH
// ==========================================================

void revisarBluetooth()
{
  while (SerialBT.available())
  {
    char c = SerialBT.read();


    // ------------------------------------------------------
    // FIN DE COMANDO
    // ------------------------------------------------------

    if (c == '\n' || c == '\r')
    {
      if (bufferBT.length() > 0)
      {
        procesarComando(bufferBT);

        bufferBT = "";
      }
    }


    // ------------------------------------------------------
    // ACUMULAR CARACTERES
    // ------------------------------------------------------

    else
    {
      bufferBT += c;


      // ----------------------------------------------------
      // COMANDO ?
      // ----------------------------------------------------

      if (c == '?')
      {
        procesarComando("?");

        bufferBT = "";
      }


      // ----------------------------------------------------
      // COMANDO R
      // ----------------------------------------------------

      else if (
        bufferBT == "R"
      )
      {
        procesarComando("R");

        bufferBT = "";
      }


      // ----------------------------------------------------
      // PROTECCIÓN DEL BUFFER
      // ----------------------------------------------------

      if (bufferBT.length() > 20)
      {
        bufferBT = "";
      }
    }
  }
}


// ==========================================================
// SETUP
// ==========================================================

void setup()
{
  Serial.begin(115200);


  // ========================================================
  // BLUETOOTH
  // ========================================================

  SerialBT.begin("ESP32-ADC");


  // ========================================================
  // LEDS
  // ========================================================

  pinMode(PIN_LED1, OUTPUT);

  pinMode(PIN_LED2, OUTPUT);

  pinMode(PIN_LED3, OUTPUT);


  digitalWrite(PIN_LED1, LOW);
  digitalWrite(PIN_LED2, LOW);
  digitalWrite(PIN_LED3, LOW);


  // ========================================================
  // ADC
  // ========================================================

  analogReadResolution(12);


  // ========================================================
  // OLED
  // ========================================================

  if (!display.begin(
        SSD1306_SWITCHCAPVCC,
        0x3C
      ))
  {
    Serial.println(
      "ERROR: OLED no encontrada"
    );

    while (true)
    {
      delay(100);
    }
  }


  display.clearDisplay();

  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(1);

  display.setCursor(0, 0);

  display.println("ESP32 ADC");

  display.println();

  display.println("Bluetooth:");

  display.println("ESP32-ADC");

  display.display();


  delay(1000);


  Serial.println();
  Serial.println(
    "=================================="
  );

  Serial.println(
    "       ESP32 - ADC + OLED"
  );

  Serial.println(
    "=================================="
  );

  Serial.println(
    "Bluetooth: ESP32-ADC"
  );

  Serial.println(
    "Potenciometro: GPIO 34"
  );

  Serial.println(
    "LED1: GPIO 12"
  );

  Serial.println(
    "LED2: GPIO 13"
  );

  Serial.println(
    "LED3: GPIO 14"
  );

  Serial.println(
    "=================================="
  );

  Serial.println(
    "Sistema listo."
  );
}


// ==========================================================
// LOOP
// ==========================================================

void loop()
{
  // ========================================================
  // LEER POTENCIOMETRO
  // ========================================================

  valorADC = analogRead(PIN_POT);


  // ========================================================
  // DETERMINAR VALOR ACTUAL
  // ========================================================

  int valorActual;


  if (valorForzado >= 0)
  {
    valorActual = valorForzado;
  }
  else
  {
    valorActual = valorADC;
  }


  // ========================================================
  // ACTUALIZAR LEDS
  // ========================================================

  actualizarLEDs(valorActual);


  // ========================================================
  // ACTUALIZAR OLED
  // ========================================================

  actualizarOLED(valorActual);


  // ========================================================
  // BLUETOOTH
  // ========================================================

  revisarBluetooth();


  // ========================================================
  // ENVIAR ESTADO
  // ========================================================

  if (
    millis() - ultimoEnvio >=
    INTERVALO_ENVIO
  )
  {
    enviarEstado(valorActual);

    ultimoEnvio = millis();
  }


  delay(20);
}
