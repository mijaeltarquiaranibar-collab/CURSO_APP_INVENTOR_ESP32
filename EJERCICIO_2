// ==========================================================
// ESP32 + 3 PULSADORES + BUZZER PASIVO + BLUETOOTH
// ==========================================================
// BOTON 1 -> GPIO 16 -> Melodía videojuego
// BOTON 2 -> GPIO 17 -> Melodía Star Wars
// BOTON 3 -> GPIO 18 -> Alarma
//
// BUZZER PASIVO -> GPIO 15
//
// PULSADORES CON PULL-DOWN EXTERNO
//
// COMANDOS BLUETOOTH (desde App Inventor):
//   '1' -> Melodía Videojuego
//   '2' -> Melodía Star Wars
//   '3' -> Alarma
//   '4' -> Detener sonido
//   'V' -> Subir volumen  (duty cycle)
//   'v' -> Bajar volumen  (duty cycle)
//   '?' -> Consultar estado
// ==========================================================

#include "BluetoothSerial.h"

BluetoothSerial SerialBT;


// ==========================================================
// PINES
// ==========================================================

#define BOTON_VIDEOJUEGO  16
#define BOTON_STARWARS    17
#define BOTON_ALARMA      18

#define BUZZER            15


// ==========================================================
// VOLUMEN (duty cycle: 0 - 255)
// 128 = 50% -> Buen valor inicial
// ==========================================================

int volumen = 128;
#define VOLUMEN_PASO  20
#define VOLUMEN_MIN    0
#define VOLUMEN_MAX  255


// ==========================================================
// ESTADO GLOBAL
// ==========================================================

bool reproduciendo = false;   // Indica si hay melodía activa
String ultimaMelodia = "";    // Nombre de la última melodía


// ==========================================================
// NOTAS MUSICALES
// ==========================================================

#define C4    261
#define D4    294
#define E4    329
#define F4    349
#define GS4   415
#define A4    440
#define AS4   466
#define B4    494

#define C5    523
#define CS5   554
#define D5    587
#define DS5   622
#define E5    659
#define F5    698
#define FS5   740
#define G5    784
#define GS5   831
#define A5    880

#define SILENCIO 0


// ==========================================================
// FUNCIÓN PARA TOCAR UNA NOTA
// ==========================================================

void beep(int frecuencia, int duracion)
{
  if (frecuencia > 0)
  {
    ledcWriteTone(BUZZER, frecuencia);
  }
  else
  {
    ledcWriteTone(BUZZER, 0);
  }

  delay(duracion);

  // Apagar nota
  ledcWriteTone(BUZZER, 0);

  // Separación entre notas
  delay(50);
}


// ==========================================================
// DETENER SONIDO
// ==========================================================

void detenerSonido()
{
  ledcWriteTone(BUZZER, 0);
  reproduciendo = false;
  enviarEstado();
}


// ==========================================================
// ENVIAR ESTADO POR BLUETOOTH
// Formato JSON simple que App Inventor puede parsear
//   {"estado":"tocando","melodia":"Star Wars","volumen":128}
// ==========================================================

void enviarEstado()
{
  String msg = "{\"estado\":\"";
  msg += reproduciendo ? "tocando" : "libre";
  msg += "\",\"melodia\":\"";
  msg += ultimaMelodia;
  msg += "\",\"volumen\":";
  msg += volumen;
  msg += "}";

  SerialBT.println(msg);
  Serial.println("BT-> " + msg);
}


// ==========================================================
// MELODÍA 1 - VIDEOJUEGO RETRO
// ==========================================================

void melodiaVideojuego()
{
  reproduciendo = true;
  ultimaMelodia = "Videojuego";
  enviarEstado();

  Serial.println("=================================");
  Serial.println("       VIDEOJUEGO RETRO");
  Serial.println("=================================");

  beep(E5, 100);
  beep(E5, 100);
  beep(E5, 100);

  beep(SILENCIO, 60);

  beep(C5, 100);
  beep(E5, 100);

  beep(G5, 180);

  beep(SILENCIO, 80);

  beep(GS4, 120);

  beep(C5, 120);
  beep(GS4, 120);
  beep(E4, 120);

  beep(A4, 120);
  beep(B4, 120);
  beep(A4, 120);

  beep(GS4, 120);
  beep(E5, 160);

  beep(G5, 120);
  beep(A5, 180);

  beep(F5, 120);
  beep(G5, 120);
  beep(E5, 120);

  beep(C5, 120);
  beep(D5, 120);
  beep(B4, 220);

  beep(E5, 120);
  beep(G5, 120);
  beep(A5, 350);

  beep(SILENCIO, 250);

  reproduciendo = false;
  enviarEstado();
}


