  beep(F4, 350);
  beep(C5, 150);

  beep(A4, 650);

  delay(500);

  // Segunda frase
  beep(E5, 500);
  beep(E5, 500);
  beep(E5, 500);

  beep(F5, 350);
  beep(C5, 150);

  beep(GS4, 500);

  beep(F4, 350);
  beep(C5, 150);

  beep(A4, 650);

